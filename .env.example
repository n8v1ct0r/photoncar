# Copy to .env on the device. Never commit .env.
# Claude API key for the optional drive summary. Read only by the server.
ANTHROPIC_API_KEY=
# Token the dashboard requires on every API call from the local network.
PHOTONCAR_API_TOKEN=
# Data directory. Defaults to ./data.
PHOTONCAR_DATA_DIR=
# Path to a file OUTSIDE this repo that lists stealth terms, one per line (make stealth-scan).
PHOTONCAR_STEALTH_TERMS_FILE=
# Public dataset root (comma2k19 lives in <root>/comma2k19). Defaults to ./data/public.
# Kept apart from PHOTONCAR_DATA_DIR so a scratch data folder still finds the dataset.
PHOTONCAR_PUBLIC_DIR=
