{
  "name": "photoncar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:embed": "tsc --noEmit -p . && vite build --mode embed",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0"
  }
}
